UPLOAD_LOCATION=/home/dietpi/media/immich
DB_DATA_LOCATION=/home/dietpi/docker_data/immich/postgres
# IMMICH_VERSION: use the current stable v3 release; update deliberately via Portainer.
# The major tag is intentional: deployment updates are still manual and reviewed.
# See: https://github.com/immich-app/immich/releases
IMMICH_VERSION=v3
IMMICH_HOST=0.0.0.0
# Conservative ML defaults for a small host; raise only after observing load.
MACHINE_LEARNING_REQUEST_THREADS=1
MACHINE_LEARNING_MODEL_INTER_OP_THREADS=1
MACHINE_LEARNING_MODEL_INTRA_OP_THREADS=1
DB_PASSWORD=REDACTED
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
