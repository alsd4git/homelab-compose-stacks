; Non-secret qBittorrent desired state for the media stack.
;
; This is a reviewed reference, not a file to mount or copy over a running
; qBittorrent instance. The live qBittorrent.conf also contains Web UI
; credentials and mutable torrent/UI state, which must remain private.
;
; Speeds in this file are KiB/s. Alternate speed limits are intentionally
; enabled: they keep the ADSL connection responsive. qbit_manage applies the
; stricter public/private group limits separately.

[BitTorrent]
Session\AddTorrentStopped=false
Session\AlternativeGlobalDLSpeedLimit=2000
Session\AlternativeGlobalUPSpeedLimit=200
Session\DefaultSavePath=/downloads/
Session\DisableAutoTMMByDefault=false
Session\GlobalUPSpeedLimit=400
Session\MaxActiveCheckingTorrents=2
Session\MaxActiveDownloads=10
; Do not reserve global queue slots for uploads: qBittorrent has no per-tag
; pools, so a public torrent must never prevent a private one from seeding.
; -1 means unlimited. Download concurrency remains capped separately above.
Session\MaxActiveTorrents=-1
Session\MaxActiveUploads=-1
Session\Port=6881
Session\QueueingSystemEnabled=true
Session\ShareLimitAction=Stop
Session\TempPath=/downloads/incomplete/
Session\TempPathEnabled=true
Session\UseAlternativeGlobalSpeedLimit=true

[Network]
PortForwardingEnabled=false
Proxy\HostnameLookupEnabled=false

[Preferences]
Connection\PortRangeMin=6881
Connection\UPnP=false
Downloads\SavePath=/downloads/
Downloads\TempPath=/downloads/incomplete/
General\Locale=en
WebUI\AlternativeUIEnabled=true
WebUI\ReverseProxySupportEnabled=true
WebUI\RootFolder=/vuetorrent
WebUI\TrustedReverseProxiesList=nginx-proxy-manager

[RSS]
AutoDownloader\DownloadRepacks=true
AutoDownloader\SmartEpisodeFilter=s(\\d+)e(\\d+), (\\d+)x(\\d+), "(\\d{4}[.\\-]\\d{1,2}[.\\-]\\d{1,2})", "(\\d{1,2}[.\\-]\\d{1,2}[.\\-]\\d{4})"
