# Media Stack Environment Variables

# Required
DOCKER_DATA_BASEFOLDER=/opt/docker/data
DOCKER_MEDIA_BASEFOLDER=/opt/docker/media

# Required for qbit_manage
QBITTORRENT_USERNAME=REPLACE_ME
QBITTORRENT_PASSWORD=REPLACE_ME

AW_APP_KEY=REPLACE_ME

# Sonarr connection used by VibraVid's manual ARR sync; keep the real key local.
SONARR_API_KEY=REPLACE_ME

# Radarr connection used by VibraVid's manual ARR sync; keep the real key local.
RADARR_API_KEY=REPLACE_ME

# API keys used by Homepage widgets.
PROWLARR_API_KEY=REPLACE_ME
SEERR_API_KEY=REPLACE_ME
JELLYFIN_API_KEY=REPLACE_ME
HOMEPAGE_ALLOWED_HOSTS=homepage.example.com
HOMEPAGE_AUTH_ENABLED=false
HOMEPAGE_AUTH_SECRET=REPLACE_ME_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET
HOMEPAGE_AUTH_PASSWORD=REPLACE_ME
HOMEPAGE_EXTERNAL_URL=http://localhost:3000

# Required by VibraVid at deployment time; generate a long random value.
VIBRAVID_DJANGO_SECRET_KEY=REPLACE_ME
VIBRAVID_PUBLIC_HOST=vibravid.example.com

# Required by Houndarr when it is exposed through Nginx Proxy Manager.
# Use the exact `npm_network` subnet (for example, 172.18.0.0/16).
HOUNDARR_TRUSTED_PROXIES=REPLACE_WITH_NPM_NETWORK_SUBNET
