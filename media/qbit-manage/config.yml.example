# qbit_manage configuration for the media stack.
# Conservative defaults: tagging and recheck only, no destructive cleanup.

qbt:
  host: "qbittorrent:8003"
  user: !ENV QBITTORRENT_USERNAME
  pass: !ENV QBITTORRENT_PASSWORD
  settings:
    force_auto_tmm: false
    tracker_error_tag: issue
    nohardlinks_tag: noHL
    stalled_tag: stalledDL
    private_tag: private
    tag_stalled_torrents: true
    cat_filter_completed: true
    tag_nohardlinks_filter_completed: true
    rem_unregistered_filter_completed: false
    disable_qbt_default_share_limits: true

directory:
  root_dir: "/downloads"
  torrents_dir: "/qbittorrent/BT_backup"

# qBittorrent appends category folders under /downloads/<Category>/ when automatic
# category-based save paths are enabled. Keep this map aligned with the live layout.
cat:
  Radarr: "/downloads/Radarr/*"
  Sonarr: "/downloads/Sonarr/*"
  Prowlarr: "/downloads/Prowlarr/*"
  Uncategorized: "/downloads/*"

tracker:
  # Private trackers use stable, human-readable tags. qbit_manage applies these
  # from the announce URL; no passkeys or tracker-specific credentials live here.
  shareisland:
    tag: ShareIsland
  itatorrents:
    tag: ItaTorrents
  # Catch-all for trackers not explicitly listed above. Before adding another
  # private tracker, add an explicit entry and its own share-limit group here.
  other:
    tag: Public

# qbit_manage applies per-torrent limits after tracker tagging. The private
# tracker policies are their respective official H&R minimums plus one day;
# the Public catch-all has a 24-hour policy. No ratio ceiling is imposed.
# A private torrent remains available when the tracker reports no other seed.
# Reaching a limit otherwise pauses the torrent; no files or entries are removed.
share_limits:
  ShareIsland:
    priority: 1
    include_all_tags:
      - ShareIsland
    max_seeding_time: 7d
    min_num_seeds: 1
    # 1,000 Kbit/s aggregate across private ShareIsland torrents (125 KiB/s).
    limit_upload_speed: 125
    enable_group_upload_speed: true
    cleanup: false
    resume_torrent_after_change: true
    share_limit_action: Stop
  ItaTorrents:
    priority: 2
    include_all_tags:
      - ItaTorrents
    max_seeding_time: 8d
    min_num_seeds: 1
    # 1,000 Kbit/s aggregate across private ItaTorrents torrents (125 KiB/s).
    limit_upload_speed: 125
    enable_group_upload_speed: true
    cleanup: false
    resume_torrent_after_change: true
    share_limit_action: Stop
  Public:
    priority: 3
    include_all_tags:
      - Public
    max_seeding_time: 24h
    # A group cap: qbit_manage divides 100 Kbit/s (about 13 KiB/s) among matching torrents.
    limit_upload_speed: 13
    enable_group_upload_speed: true
    cleanup: false
    resume_torrent_after_change: false
    share_limit_action: Stop

nohardlinks:
  Radarr:
    exclude_tags: []
    ignore_root_dir: true
  Sonarr:
    exclude_tags: []
    ignore_root_dir: true
