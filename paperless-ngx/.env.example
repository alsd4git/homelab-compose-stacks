# Paperless-ngx Stack Environment Variables

# Required
DOCKER_DATA_BASEFOLDER=/opt/docker/data

# Required by Paperless-ngx v3. Generate once with:
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Keep the generated value private and stable; rotating it invalidates sessions
# and other signed tokens.
# Public CI-only placeholder. Generate and keep a unique secret in the untracked
# deployment environment; never use this value in a real Paperless instance.
PAPERLESS_SECRET_KEY=CI_ONLY_PLACEHOLDER_NOT_FOR_DEPLOYMENT
