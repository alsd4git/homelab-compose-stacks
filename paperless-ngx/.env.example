# Paperless-ngx Stack Environment Variables

# Required
DOCKER_DATA_BASEFOLDER=/opt/docker/data

# Required by Paperless-ngx v3. Generate once with:
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Keep the generated value private and stable; rotating it invalidates sessions
# and other signed tokens.
PAPERLESS_SECRET_KEY=
